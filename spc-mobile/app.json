{
  "expo": {
    "name": "SPC Cockpit",
    "slug": "spc-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spc",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a6b7e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.spc.cockpit"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a6b7e"
      },
      "package": "fr.spc.cockpit"
    },
    "plugins": ["expo-router"]
  }
}
