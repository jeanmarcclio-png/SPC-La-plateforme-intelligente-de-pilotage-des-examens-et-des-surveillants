# SPC Cockpit — variables d'environnement (exemple)
# Copier ce fichier en .env.local et renseigner les vraies valeurs.
# NE JAMAIS committer de secret réel. Les clés « service » restent côté serveur.

# --- Supabase (obligatoire) ---
# URL du projet et clé publique « anon ». La clé anon est publique par design ;
# la sécurité repose sur les policies RLS, pas sur le secret de cette clé.
#
# ⚠️ RÉGION : créer le projet Supabase en Union européenne (RGPD) —
#    eu-central-1 (Francfort) ou eu-west-3 (Paris). La région se choisit à la
#    création du projet et n'est pas modifiable ensuite.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...votre-cle-anon

# Référence du projet (portion « xxxxxxxxxxxx » de l'URL), utilisée par
# `npm run db:types` pour régénérer lib/supabase/database.types.ts.
SUPABASE_PROJECT_ID=xxxxxxxxxxxx

# --- Contrôle d'accès par rôle (optionnel) ---
# "1" active l'application stricte des rôles (mode transition sinon : tout
# utilisateur authentifié est autorisé). N'activer qu'une fois les rôles semés.
SPC_ENFORCE_ROLES=0

# --- IA opérationnelle (optionnel — fonctionnalités d'aide à la décision) ---
ANTHROPIC_API_KEY=

# --- Emails transactionnels (optionnel) ---
RESEND_API_KEY=

# --- Notifications Web Push (optionnel) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.fr

# --- Sécurité du endpoint cron (optionnel) ---
# Secret partagé attendu par /api/push/cron pour refuser les appels non autorisés.
CRON_SECRET=
